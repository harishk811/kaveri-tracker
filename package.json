{
  "name": "marathon-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:selectors": "node scripts/check-selectors.mjs",
    "check:smoke": "esbuild tests/render-smoke.mts --bundle --format=esm --platform=node --alias:@=./src --external:jsdom --jsx=automatic --outfile=node_modules/.tmp/render-smoke.mjs && node node_modules/.tmp/render-smoke.mjs",
    "check:all": "npm run check:selectors && npm run check:smoke && npm run build"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "framer-motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
